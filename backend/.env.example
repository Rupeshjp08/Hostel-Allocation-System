# ── Backend environment variables ─────────────────────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env itself.

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hostel-room-allocation?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# The frontend origin allowed by CORS (set to your Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Warden seed credentials (used by: npm run seed:warden)
WARDEN_EMAIL=warden@hostel.edu
WARDEN_PASSWORD=ChangeThisPassword123
WARDEN_NAME=Hostel Warden
